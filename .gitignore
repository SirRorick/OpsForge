node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

reference/GameAssets/

# reference/ is a private working directory in its entirety: the AssetRipper
# extraction, the packaged builds, design references, notes. None of it is
# published.
reference/

# assets/ is committed in full — thumbnails and meshes both. They are the
# game's artwork, included with the developers' permission, staged out of the
# dump by `npm run stage-assets`. A fresh clone is the whole editor.

# dist/ is a build output and nothing else: `npm run build` writes the bundle
# there and `npm run package` assembles the release folder and its zip beside
# it. All of it is reproducible from src/ and assets/, and the zip alone is
# bigger than the rest of the repository, so none of it is committed. Releases
# carry the artefact; git carries what it was built from.
dist/

# Local working directories, kept on the machine.
test/

# Local development notes — kept on the machine, not published.
CLAUDE.md
